# Edifyce configuration
#
# Copy to `.env` and fill in. All values are optional: with none set, the app
# runs exactly as before — a stateless compile/verify API with no database.

# ---------------------------------------------------------------------------
# Database (optional)
# ---------------------------------------------------------------------------
# Postgres connection string for the persistence layer (see app/db/). On Neon +
# Vercel, use the POOLED connection string (the host contains "-pooler"); the
# app uses NullPool and lets Neon's PgBouncer own connection pooling, which is
# what keeps serverless functions from exhausting connections.
#
# postgres:// and postgresql:// are both accepted and routed to asyncpg. If
# DATABASE_URL is unset the app falls back to POSTGRES_URL (auto-provisioned by
# the Neon/Vercel Marketplace integration), so either name works.
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/edifyce?sslmode=require

# ---------------------------------------------------------------------------
# Authentication (needs DATABASE_URL)
# ---------------------------------------------------------------------------
# Secret used to sign auth JWTs and password-reset / email-verification tokens.
# SET A STABLE VALUE IN PRODUCTION. If unset, the app signs with a fresh
# per-process random secret — safe (no checked-in key, cookies unforgeable) but
# sessions won't survive a restart or span multiple worker/serverless instances,
# which effectively breaks login on a scaled-out deploy. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# EDIFYCE_AUTH_SECRET=replace-with-a-long-random-value

# Session/cookie lifetime in seconds (default 604800 = 7 days).
# EDIFYCE_AUTH_LIFETIME_SECONDS=604800

# `Secure` flag on the auth cookie (default true). Set false for local HTTP dev,
# where the browser would otherwise refuse to store a Secure cookie.
# EDIFYCE_AUTH_COOKIE_SECURE=false

# Name of the auth cookie (default edifyce_auth).
# EDIFYCE_AUTH_COOKIE_NAME=edifyce_auth

# ---------------------------------------------------------------------------
# Social login / OAuth (optional; needs DATABASE_URL)
# ---------------------------------------------------------------------------
# Each provider is enabled only when BOTH its client id and secret are set.
# Register an OAuth app with each provider and set the callback (redirect) URL to
#   https://<your-host>/auth/<provider>/callback
# e.g. https://edifyce.example.com/auth/github/callback
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=

# Pin the callback origin used in the redirect_uri. Needed when a TLS-terminating
# proxy would otherwise make the auto-derived redirect_uri http:// and mismatch
# the provider's registered callback. When unset it's derived from the request.
# EDIFYCE_OAUTH_REDIRECT_URL_BASE=https://edifyce.example.com

# Where the browser lands after a successful OAuth sign-in (default /).
# EDIFYCE_OAUTH_SUCCESS_REDIRECT=/

# ---------------------------------------------------------------------------
# Migrations / Atlas (dev + CI only)
# ---------------------------------------------------------------------------
# The database Atlas uses as a disposable scratch to plan/verify migrations. It
# must have the pgvector extension available. Defaults to a pgvector Docker image
# (see atlas.hcl); override to point at a local Postgres or a Neon dev branch.
# ATLAS_DEV_URL=postgres://postgres@127.0.0.1:5433/dev?sslmode=disable

# ---------------------------------------------------------------------------
# CORS (optional) — comma-separated origins for a cross-origin frontend.
# ---------------------------------------------------------------------------
# EDIFYCE_CORS_ORIGINS=https://edifyce.example.com

# ---------------------------------------------------------------------------
# Static frontend (optional) — path to the built SvelteKit bundle the API
# serves at /. Defaults to frontend/build; override when the bundle is copied
# elsewhere (e.g. in a container image).
# ---------------------------------------------------------------------------
# EDIFYCE_FRONTEND_BUILD=/app/frontend/build
