# Base URL of the Edifyce FastAPI backend.
#
# Leave unset for same-origin requests. This is the default and the right
# choice when the built bundle is served by FastAPI (see app/main.py) or behind
# a reverse proxy on the same origin. In development the dev server proxies the
# API paths to the backend, so relative requests work without setting this.
#
# Set it only to target a backend on a DIFFERENT origin (that origin must then
# be listed in the backend's EDIFYCE_CORS_ORIGINS):
# VITE_API_BASE_URL=https://api.example.com

# Where the dev server proxies API calls (dev only). Defaults to the local
# uvicorn address.
# VITE_API_PROXY_TARGET=http://localhost:8000
